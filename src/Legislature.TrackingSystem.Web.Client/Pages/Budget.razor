@page "/budget"
@attribute [Authorize(Policy = "RequirePrepare")]
@inject HttpClient Http

<PageTitle>Budget Bills</PageTitle>

<section class="page-shell pb-5">
    <div class="eyebrow">Sprint 12 &middot; RFA Supporting Analysis</div>
    <h1>Budget Bills</h1>
    <p class="lede">
        Flag bills included in the DOR budget and compare them with associated fiscal notes.
    </p>

    @if (Error is not null)
    {
        <div class="alert alert-danger mt-3" role="alert">@Error</div>
    }

    <div class="row g-3">
        <div class="col-md-4">
            <div class="card queue-card">
                <div class="card-header"><span class="card-title">Flagged budget bills</span></div>
                <div class="card-body p-0">
                    @if (FlaggedBills.Count == 0)
                    {
                        <div class="p-3 text-muted small">No flagged budget bills.</div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var bill in FlaggedBills)
                            {
                                <li class="list-group-item @(SelectedId == bill.Id ? "active" : "")" @onclick="() => Select(bill.Id)" role="button">
                                    <div class="fw-semibold">@bill.BillNumber</div>
                                    <div class="small text-muted">@bill.Title</div>
                                    <div class="small"><span class="badge text-bg-light border">@bill.Status</span></div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card queue-card mb-3">
                <div class="card-header"><span class="card-title">Flag a bill</span></div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <input class="form-control form-control-sm" @bind="BillNumber" placeholder="Bill number" />
                        </div>
                        <div class="col-md-6">
                            <button class="btn btn-outline-primary btn-sm" @onclick="FlagBill">Flag as budget bill</button>
                        </div>
                    </div>
                </div>
            </div>

            @if (Selected is not null)
            {
                <div class="card queue-card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span class="card-title">@Selected.BillNumber &middot; @Selected.Title</span>
                        <span class="badge text-bg-light border">@Selected.Status</span>
                    </div>
                    <div class="card-body">
                        <div class="row g-2">
                            <div class="col-md-6">
                                <input class="form-control form-control-sm" @bind="FiscalNoteIdentifier" placeholder="Fiscal note identifier" />
                            </div>
                            <div class="col-md-6">
                                <button class="btn btn-outline-primary btn-sm" @onclick="LinkFiscalNote">Link fiscal note</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card queue-card">
                    <div class="card-header"><span class="card-title">Associated fiscal notes</span></div>
                    <div class="card-body p-0">
                        @if (FiscalNotes.Count == 0)
                        {
                            <div class="p-3 text-muted small">No fiscal notes linked.</div>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var note in FiscalNotes)
                                {
                                    <li class="list-group-item">
                                        <div class="fw-semibold">@note.Identifier &middot; @note.Title</div>
                                        <div class="small text-muted">@note.Status</div>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="card queue-card">
                    <div class="card-body p-4 text-center text-muted">Select a flagged budget bill to compare fiscal notes.</div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private IReadOnlyList<BillDto> FlaggedBills { get; set; } = Array.Empty<BillDto>();
    private IReadOnlyList<WorkTaskDto> FiscalNotes { get; set; } = Array.Empty<WorkTaskDto>();
    private Guid? SelectedId { get; set; }
    private BillDto? Selected { get; set; }
    private string BillNumber { get; set; } = string.Empty;
    private string FiscalNoteIdentifier { get; set; } = string.Empty;
    private string? Error { get; set; }

    private static readonly System.Text.Json.JsonSerializerOptions JsonOptions = new(System.Text.Json.JsonSerializerDefaults.Web)
    {
        Converters = { new System.Text.Json.Serialization.JsonStringEnumConverter() },
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadFlaggedAsync();
    }

    private async Task LoadFlaggedAsync()
    {
        try
        {
            FlaggedBills = await Http.GetFromJsonAsync<List<BillDto>>("/api/v1/bills/budget", JsonOptions) ?? new List<BillDto>();
        }
        catch (Exception ex)
        {
            Error = ApiErrorFormatter.Format(ex);
        }
    }

    private async Task FlagBill()
    {
        if (string.IsNullOrWhiteSpace(BillNumber))
        {
            Error = "Enter a bill number.";
            return;
        }

        Error = null;
        try
        {
            var all = await Http.GetFromJsonAsync<List<BillDto>>("/api/v1/bills/history?billNumber=", JsonOptions);
            var match = all?.FirstOrDefault(b => string.Equals(b.BillNumber, BillNumber, StringComparison.OrdinalIgnoreCase));
            if (match is null)
            {
                Error = $"Bill '{BillNumber}' was not found. Ingest it on the Bills page first.";
                return;
            }

            using HttpResponseMessage response = await Http.PostAsJsonAsync(
                $"/api/v1/bills/{match.Id}/budget-flag",
                new { isBudgetBill = true },
                JsonOptions);
            string? message = await TryReadErrorAsync(response);
            if (!response.IsSuccessStatusCode)
            {
                Error = message ?? $"Flag failed ({response.StatusCode}).";
                return;
            }

            BillNumber = string.Empty;
            await LoadFlaggedAsync();
        }
        catch (Exception ex)
        {
            Error = ApiErrorFormatter.Format(ex);
        }
    }

    private async Task Select(Guid id)
    {
        SelectedId = id;
        Error = null;
        FiscalNotes = Array.Empty<WorkTaskDto>();
        try
        {
            Selected = FlaggedBills.FirstOrDefault(b => b.Id == id);
            if (Selected is not null)
            {
                FiscalNotes = await Http.GetFromJsonAsync<List<WorkTaskDto>>($"/api/v1/bills/{id}/fiscal-notes", JsonOptions) ?? new List<WorkTaskDto>();
            }
        }
        catch (Exception ex)
        {
            Error = ApiErrorFormatter.Format(ex);
        }
    }

    private async Task LinkFiscalNote()
    {
        if (Selected is null || string.IsNullOrWhiteSpace(FiscalNoteIdentifier))
        {
            Error = "Select a bill and enter a fiscal note identifier.";
            return;
        }

        Error = null;
        try
        {
            var all = await Http.GetFromJsonAsync<WorkItemQueryResultDto>("/api/v1/work-items?groupBy=None", JsonOptions);
            var items = all?.Groups.SelectMany(g => g.Items).ToList() ?? new List<WorkTaskDto>();
            var match = items.FirstOrDefault(i => string.Equals(i.Identifier, FiscalNoteIdentifier, StringComparison.OrdinalIgnoreCase));
            if (match is null)
            {
                Error = $"Work product '{FiscalNoteIdentifier}' was not found.";
                return;
            }

            using HttpResponseMessage response = await Http.PostAsJsonAsync(
                $"/api/v1/bills/{Selected.Id}/fiscal-notes",
                new { workTaskId = match.Id, linkedByKey = "jdoe" },
                JsonOptions);
            string? message = await TryReadErrorAsync(response);
            if (!response.IsSuccessStatusCode)
            {
                Error = message ?? $"Link failed ({response.StatusCode}).";
                return;
            }

            FiscalNoteIdentifier = string.Empty;
            FiscalNotes = await Http.GetFromJsonAsync<List<WorkTaskDto>>($"/api/v1/bills/{Selected.Id}/fiscal-notes", JsonOptions) ?? new List<WorkTaskDto>();
        }
        catch (Exception ex)
        {
            Error = ApiErrorFormatter.Format(ex);
        }
    }

    private static async Task<string?> TryReadErrorAsync(HttpResponseMessage response)
    {
        if (response.IsSuccessStatusCode || response.Content is null)
        {
            return null;
        }

        try
        {
            var body = await response.Content.ReadFromJsonAsync<ErrorBody>(JsonOptions);
            return body?.error;
        }
        catch
        {
            return null;
        }
    }

    private sealed record ErrorBody(string? error);

    private sealed record BillDto(Guid Id, string BillNumber, string Title, BillStatus Status, string CurrentVersion, string CurrentLanguage, int Year, string Biennium, DateTimeOffset CreatedAt, DateTimeOffset UpdatedAt, bool IsBudgetBill, IReadOnlyList<BillVersionDto> Versions, IReadOnlyList<BillAmendmentDto> Amendments);

    private sealed record BillVersionDto(Guid Id, Guid BillId, string VersionLabel, string Language, DateTimeOffset CapturedAt, string? Source);

    private sealed record BillAmendmentDto(Guid Id, Guid BillId, string AmendmentNumber, string Language, DateTimeOffset CapturedAt, string? Source);

    private sealed record WorkItemQueryResultDto(IReadOnlyList<WorkItemGroupDto> Groups, int TotalCount);

    private sealed record WorkItemGroupDto(string Key, int Count, IReadOnlyList<WorkTaskDto> Items);

    private sealed record WorkTaskDto(Guid Id, string Identifier, string Title, WorkTaskStatus Status);
}
