@page "/work-queue"
@attribute [Authorize(Policy = "RequireReadOnly")]
@inject HttpClient Http

<PageTitle>Work Queue</PageTitle>

<section class="page-shell page-shell-wide pb-5">
    <div class="eyebrow">Sprint 3 &middot; Assignment &amp; Work Queues</div>
    <h1>My work queue</h1>
    <p class="lede">
        See all work assigned to a DOR user, with status, priority, role, per-assignment due dates,
        and rework identification so workload can be managed at a glance.
    </p>

    <div class="queue-wrap">
        <div class="card queue-card">
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-md-5">
                        <label for="q-user" class="form-label">DOR user</label>
                        <input id="q-user" class="form-control" @bind="UserKey"
                               placeholder="e.g., jdoe" />
                    </div>
                    <div class="col-md-3">
                        <button type="button" class="btn btn-primary" @onclick="LoadQueue" disabled="@IsBusy">
                            <svg class="me-1" aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/></svg>
                            @(IsBusy ? "Loading…" : "Load queue")
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @if (Error is not null)
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 mt-3" role="alert">
                <span aria-hidden="true" class="alert-icon">
                    <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor"><path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/></svg>
                </span>
                <span>@Error</span>
            </div>
        }

        @if (Queue is not null)
        {
            <div class="card queue-card mt-3">
                <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <span class="card-title">Queue for <strong>@Queue.AssigneeKey</strong></span>
                    <span class="text-muted small">
                        @Queue.Count item@(Queue.Count == 1 ? "" : "s") &middot;
                        @Queue.ReworkCount rework
                    </span>
                </div>
                <div class="card-body p-0">
                    @if (Queue.Entries.Count == 0)
                    {
                        <div class="p-4 text-center text-muted">No work assigned to this user yet.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 queue-table">
                                <thead>
                                    <tr>
                                        <th>Identifier</th>
                                        <th>Title</th>
                                        <th>Type</th>
                                        <th>Priority</th>
                                        <th>Status</th>
                                        <th>Role</th>
                                        <th>Due date</th>
                                        <th>Rework</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var entry in Queue.Entries)
                                    {
                                        <tr>
                                            <td><span class="badge text-bg-light border">@entry.TaskIdentifier</span></td>
                                            <td>@entry.Title</td>
                                            <td>@entry.Type</td>
                                            <td><span class="badge priority-@entry.Priority.ToString().ToLowerInvariant()">@entry.Priority</span></td>
                                            <td>@entry.Status</td>
                                            <td>@entry.Role</td>
                                            <td>@(entry.AssignmentDueDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                                            <td>
                                                @if (entry.IsRework)
                                                {
                                                    <span class="badge text-bg-warning">Rework</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>

@code {
    private string UserKey { get; set; } = "jdoe";
    private bool IsBusy { get; set; }
    private string? Error { get; set; }
    private WorkQueueDto? Queue { get; set; }

    private static readonly System.Text.Json.JsonSerializerOptions JsonOptions = new(System.Text.Json.JsonSerializerDefaults.Web)
    {
        Converters = { new System.Text.Json.Serialization.JsonStringEnumConverter() },
    };

    private async Task LoadQueue()
    {
        if (string.IsNullOrWhiteSpace(UserKey))
        {
            Error = "Enter a DOR user key to load their work queue.";
            return;
        }

        IsBusy = true;
        Error = null;
        Queue = null;

        try
        {
            string key = Uri.EscapeDataString(UserKey.Trim());
            Queue = await Http.GetFromJsonAsync<WorkQueueDto>($"/api/v1/work-queue/{key}", JsonOptions);
        }
        catch (Exception ex)
        {
            Error = ApiErrorFormatter.Format(ex);
        }
        finally
        {
            IsBusy = false;
        }
    }

    private sealed record WorkQueueDto(
        string AssigneeKey,
        int Count,
        int ReworkCount,
        IReadOnlyList<WorkQueueEntryDto> Entries);

    private sealed record WorkQueueEntryDto(
        Guid TaskId,
        string TaskIdentifier,
        string Title,
        WorkItemType Type,
        TaskPriority Priority,
        WorkTaskStatus Status,
        DateOnly? TaskDueDate,
        Guid AssignmentId,
        AssignmentRole Role,
        DateOnly? AssignmentDueDate,
        bool IsRework,
        DateTimeOffset AssignedAt);
}
