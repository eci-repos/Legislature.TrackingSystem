@page "/work-items"
@attribute [Authorize(Policy = "RequireReadOnly")]
@inject HttpClient Http

<PageTitle>Work Items</PageTitle>

<section class="page-shell page-shell-wide pb-5">
    <div class="eyebrow">Sprint 6 &middot; Configurable Workflow</div>
    <h1>Work items</h1>
    <p class="lede">
        Identify, sort, filter, and group legislative work using designated criteria, and drive each
        item through review and approval before it is finalized for submission.
    </p>

    <div class="queue-wrap">
        <div class="card queue-card">
            <div class="card-header">
                <span class="card-title">Filter, sort &amp; group</span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Confidential</label>
                        <select class="form-select" @bind="Confidential">
                            <option value="">All</option>
                            <option value="true">Yes</option>
                            <option value="false">No</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Executive review</label>
                        <select class="form-select" @bind="ExecutiveReview">
                            <option value="">All</option>
                            <option value="true">Yes</option>
                            <option value="false">No</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Status</label>
                        <select class="form-select" @bind="Status">
                            <option value="">All</option>
                            @foreach (var s in Enum.GetValues<WorkTaskStatus>())
                            {
                                <option value="@s">@s</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Work type</label>
                        <select class="form-select" @bind="Type">
                            <option value="">All</option>
                            @foreach (var t in Enum.GetValues<WorkItemType>())
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Package</label>
                        <select class="form-select" @bind="PackageId">
                            <option value="">All</option>
                            @foreach (var p in Packages)
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Sort by</label>
                        <select class="form-select" @bind="SortBy">
                            @foreach (var s in Enum.GetValues<WorkItemSortField>())
                            {
                                <option value="@s">@s</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Direction</label>
                        <select class="form-select" @bind="SortDescending">
                            <option value="false">Ascending</option>
                            <option value="true">Descending</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Group by</label>
                        <select class="form-select" @bind="GroupBy">
                            @foreach (var g in Enum.GetValues<WorkItemGroupBy>())
                            {
                                <option value="@g">@g</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <button type="button" class="btn btn-primary" @onclick="ApplyQuery" disabled="@IsBusy">
                            <svg class="me-1" aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/></svg>
                            @(IsBusy ? "Applying…" : "Apply")
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @if (Error is not null)
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 mt-3" role="alert">
                <span aria-hidden="true" class="alert-icon">
                    <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor"><path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/></svg>
                </span>
                <span>@Error</span>
            </div>
        }

        @if (Result is not null)
        {
            <div class="card queue-card mt-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="card-title">Results</span>
                    <span class="text-muted small">@Result.TotalCount item@(Result.TotalCount == 1 ? "" : "s")</span>
                </div>
                <div class="card-body p-0">
                    @if (Result.TotalCount == 0)
                    {
                        <div class="p-4 text-center text-muted">No work items match the current criteria.</div>
                    }
                    else
                    {
                        @foreach (var group in Result.Groups)
                        {
                            <div class="p-3 border-bottom">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-semibold">@(string.IsNullOrEmpty(group.Key) ? "All" : group.Key)</span>
                                    <span class="badge text-bg-light border">@group.Count</span>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0 queue-table">
                                        <thead>
                                            <tr>
                                                <th>Identifier</th>
                                                <th>Title</th>
                                                <th>Type</th>
                                                <th>Priority</th>
                                                <th>Status</th>
                                                <th>Conf.</th>
                                                <th>Exec.</th>
                                                <th>Workflow</th>
                                                <th>Exec Review</th>
                                                <th>Steps</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in group.Items)
                                            {
                                                <tr>
                                                    <td><span class="badge text-bg-light border">@item.Identifier</span></td>
                                                    <td>@item.Title</td>
                                                    <td>@item.Type</td>
                                                    <td>
                                                        <select class="form-select form-select-sm" style="min-width:90px" value="@item.Priority" @onchange="(e) => SetPriority(item, e.Value?.ToString() ?? string.Empty)">
                                                            @foreach (var p in Enum.GetValues<TaskPriority>())
                                                            {
                                                                <option value="@p">@p</option>
                                                            }
                                                        </select>
                                                    </td>
                                                    <td>@item.Status</td>
                                                    <td>@(item.IsConfidential ? "Yes" : "—")</td>
                                                    <td>@(item.IsExecutiveReview ? "Yes" : "—")</td>
                                                    <td><span class="badge workflow-@item.WorkflowStatus.ToString().ToLowerInvariant()">@item.WorkflowStatus</span></td>
                                                    <td>
                                                        <span class="badge workflow-@item.ExecutiveReviewStatus.ToString().ToLowerInvariant()">@item.ExecutiveReviewStatus</span>
                                                        @if (item.ExecutiveReviewStatus == ExecutiveReviewStatus.NotStarted)
                                                        {
                                                            <button class="btn btn-sm btn-primary mt-1" @onclick="() => ExOnStart(item)">Start</button>
                                                            @if (ExActiveItemId == item.Id && ExMode == "start")
                                                            {
                                                                <div class="mt-1">
                                                                    <input class="form-control form-control-sm mb-1" placeholder="Reviewer keys, comma separated" @bind="ExReviewerKeysInput" />
                                                                    <button class="btn btn-sm btn-primary" @onclick="() => ExStart(item)">Start</button>
                                                                    <button class="btn btn-sm btn-outline-secondary" @onclick="ExCancel">Cancel</button>
                                                                </div>
                                                            }
                                                        }
                                                        else if (item.ExecutiveReviewStatus == ExecutiveReviewStatus.InProgress)
                                                        {
                                                            var current = item.ExecutiveReviewers.FirstOrDefault(r => r.Status != ExecutiveReviewerStatus.Completed);
                                                            <div class="small text-muted mt-1">@(current?.ReviewerKey)</div>
                                                            <div class="d-flex flex-wrap gap-1 mt-1">
                                                                <button class="btn btn-sm btn-primary" @onclick="() => ExBegin(item, current?.ReviewerKey ?? string.Empty)">Begin</button>
                                                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => ExOnAdjust(item)">Adjust</button>
                                                                <button class="btn btn-sm btn-success" @onclick="() => ExOnComplete(item)">Complete</button>
                                                            </div>
                                                            @if (ExActiveItemId == item.Id && ExMode == "adjust")
                                                            {
                                                                <div class="mt-1">
                                                                    <input class="form-control form-control-sm mb-1" placeholder="Adjustment note" @bind="ExNoteInput" />
                                                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => ExAdjust(item, current?.ReviewerKey ?? string.Empty)">Save</button>
                                                                    <button class="btn btn-sm btn-outline-secondary" @onclick="ExCancel">Cancel</button>
                                                                </div>
                                                            }
                                                            @if (ExActiveItemId == item.Id && ExMode == "complete")
                                                            {
                                                                <div class="mt-1">
                                                                    <input class="form-control form-control-sm mb-1" placeholder="Comment (optional)" @bind="ExCommentInput" />
                                                                    <button class="btn btn-sm btn-success" @onclick="() => ExComplete(item, current?.ReviewerKey ?? string.Empty)">Complete</button>
                                                                    <button class="btn btn-sm btn-outline-secondary" @onclick="ExCancel">Cancel</button>
                                                                </div>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted small">Done</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (item.Steps.Count == 0)
                                                        {
                                                            <span class="text-muted small">—</span>
                                                        }
                                                        else
                                                        {
                                                            <ul class="list-unstyled small mb-0">
                                                                @foreach (var s in item.Steps)
                                                                {
                                                                    <li>@s.Name <span class="text-muted">@(s.DueDate?.ToString("MMM d") ?? "no due date")</span></li>
                                                                }
                                                            </ul>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (item.WorkflowStatus is WorkflowStatus.Draft or WorkflowStatus.Rejected)
                                                        {
                                                            <button class="btn btn-sm btn-primary" @onclick="() => OnSubmitClick(item)">Submit</button>
                                                            @if (ActiveItemId == item.Id && ActiveMode == "submit")
                                                            {
                                                                <div class="mt-2">
                                                                    <input class="form-control form-control-sm mb-1" placeholder="Reviewer keys, comma separated" @bind="ReviewerKeysInput" />
                                                                    <button class="btn btn-sm btn-primary" @onclick="() => SubmitReview(item)" disabled="@IsBusy">Send</button>
                                                                    <button class="btn btn-sm btn-outline-secondary" @onclick="CancelAction">Cancel</button>
                                                                </div>
                                                            }
                                                        }
                                                        else if (item.WorkflowStatus is WorkflowStatus.PendingReview or WorkflowStatus.UnderReview)
                                                        {
                                                            <div class="d-flex align-items-center gap-2">
                                                                <input class="form-control form-control-sm" style="max-width:120px" placeholder="Your user key" @bind="ReviewerKeyInput" />
                                                                <button class="btn btn-sm btn-success" @onclick="() => RecordDecision(item, WorkflowDecision.Approved)">Approve</button>
                                                                <button class="btn btn-sm btn-danger" @onclick="() => OnRejectClick(item)">Reject</button>
                                                            </div>
                                                            @if (ActiveItemId == item.Id && ActiveMode == "reject")
                                                            {
                                                                <div class="mt-2">
                                                                    <input class="form-control form-control-sm mb-1" placeholder="Reason (optional)" @bind="ReviewCommentInput" />
                                                                    <button class="btn btn-sm btn-danger" @onclick="() => RecordDecision(item, WorkflowDecision.Rejected)">Reject</button>
                                                                    <button class="btn btn-sm btn-outline-secondary" @onclick="CancelAction">Cancel</button>
                                                                </div>
                                                            }
                                                        }
                                                        else if (item.WorkflowStatus == WorkflowStatus.Approved)
                                                        {
                                                            <button class="btn btn-sm btn-primary" @onclick="() => FinalizeItem(item)">Finalize</button>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">Finalized</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>
</section>

@code {
    private enum WorkItemSortField { Identifier, Title, Type, Priority, Status, DueDate, CreatedAt }

    private enum WorkItemGroupBy { None, Type, Status, Package, Confidential, ExecutiveReview }

    private string Confidential { get; set; } = string.Empty;
    private string ExecutiveReview { get; set; } = string.Empty;
    private string Status { get; set; } = string.Empty;
    private string Type { get; set; } = string.Empty;
    private string PackageId { get; set; } = string.Empty;
    private WorkItemSortField SortBy { get; set; } = WorkItemSortField.CreatedAt;
    private bool SortDescending { get; set; }
    private WorkItemGroupBy GroupBy { get; set; } = WorkItemGroupBy.None;
    private bool IsBusy { get; set; }
    private string? Error { get; set; }
    private WorkItemQueryResultDto? Result { get; set; }
    private IReadOnlyList<PackageDto> Packages { get; set; } = Array.Empty<PackageDto>();

    private Guid? ActiveItemId { get; set; }
    private string ActiveMode { get; set; } = string.Empty;
    private string ReviewerKeysInput { get; set; } = string.Empty;
    private string ReviewerKeyInput { get; set; } = "jdoe";
    private string ReviewCommentInput { get; set; } = string.Empty;

    private Guid? ExActiveItemId { get; set; }
    private string ExMode { get; set; } = string.Empty;
    private string ExReviewerKeysInput { get; set; } = string.Empty;
    private string ExNoteInput { get; set; } = string.Empty;
    private string ExCommentInput { get; set; } = string.Empty;

    private void BeginAction(Guid itemId, string mode)
    {
        ActiveItemId = itemId;
        ActiveMode = mode;
        ReviewerKeysInput = string.Empty;
        ReviewCommentInput = string.Empty;
    }

    private void CancelAction()
    {
        ActiveItemId = null;
        ActiveMode = string.Empty;
    }

    private void OnSubmitClick(WorkTaskDto item) => BeginAction(item.Id, "submit");

    private void OnRejectClick(WorkTaskDto item) => BeginAction(item.Id, "reject");

    private async Task SubmitReview(WorkTaskDto item)
    {
        if (string.IsNullOrWhiteSpace(ReviewerKeysInput))
        {
            Error = "Enter at least one reviewer key.";
            return;
        }

        var keys = ReviewerKeysInput
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        await PostAsync($"/api/v1/work-items/{item.Id}/submit-for-review", new { reviewerKeys = keys, submittedByKey = ReviewerKeyInput });
    }

    private async Task RecordDecision(WorkTaskDto item, WorkflowDecision decision)
    {
        await PostAsync($"/api/v1/work-items/{item.Id}/reviews", new { reviewerKey = ReviewerKeyInput, decision, comment = ReviewCommentInput });
    }

    private async Task FinalizeItem(WorkTaskDto item)
    {
        await PostAsync($"/api/v1/work-items/{item.Id}/finalize", null);
    }

    private async Task PostAsync(string url, object? body)
    {
        IsBusy = true;
        Error = null;
        try
        {
            using HttpResponseMessage response = body is null
                ? await Http.PostAsync(url, null)
                : await Http.PostAsJsonAsync(url, body, JsonOptions);

            string? message = await TryReadErrorAsync(response);
            if (!response.IsSuccessStatusCode)
            {
                Error = message ?? $"Request failed ({response.StatusCode}).";
                return;
            }

            ActiveItemId = null;
            ActiveMode = string.Empty;
            await ApplyQuery();
        }
        catch (Exception ex)
        {
            Error = ApiErrorFormatter.Format(ex);
        }
        finally
        {
            IsBusy = false;
        }
    }

    private static async Task<string?> TryReadErrorAsync(HttpResponseMessage response)
    {
        if (response.IsSuccessStatusCode || response.Content is null)
        {
            return null;
        }

        try
        {
            var body = await response.Content.ReadFromJsonAsync<ErrorBody>(JsonOptions);
            return body?.error;
        }
        catch
        {
            return null;
        }
    }

    private sealed record ErrorBody(string? error);

    private void ExOnStart(WorkTaskDto item) => ExBeginAction(item.Id, "start");

    private void ExOnAdjust(WorkTaskDto item) => ExBeginAction(item.Id, "adjust");

    private void ExOnComplete(WorkTaskDto item) => ExBeginAction(item.Id, "complete");

    private void ExBeginAction(Guid itemId, string mode)
    {
        ExActiveItemId = itemId;
        ExMode = mode;
        ExReviewerKeysInput = string.Empty;
        ExNoteInput = string.Empty;
        ExCommentInput = string.Empty;
    }

    private void ExCancel()
    {
        ExActiveItemId = null;
        ExMode = string.Empty;
    }

    private async Task ExStart(WorkTaskDto item)
    {
        if (string.IsNullOrWhiteSpace(ExReviewerKeysInput))
        {
            Error = "Enter at least one executive reviewer key.";
            return;
        }

        var keys = ExReviewerKeysInput
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        await PostAsync($"/api/v1/work-items/{item.Id}/executive-review/start", new { reviewerKeys = keys, startedByKey = ReviewerKeyInput });
    }

    private async Task ExBegin(WorkTaskDto item, string reviewerKey)
    {
        await PostAsync($"/api/v1/work-items/{item.Id}/executive-review/begin", new { reviewerKey });
    }

    private async Task ExAdjust(WorkTaskDto item, string reviewerKey)
    {
        await PostAsync($"/api/v1/work-items/{item.Id}/executive-review/adjust", new { reviewerKey, note = ExNoteInput });
    }

    private async Task ExComplete(WorkTaskDto item, string reviewerKey)
    {
        await PostAsync($"/api/v1/work-items/{item.Id}/executive-review/complete", new { reviewerKey, comment = ExCommentInput });
    }

    private async Task SetPriority(WorkTaskDto item, string priority)
    {
        if (Enum.TryParse<TaskPriority>(priority, out TaskPriority parsed))
        {
            await PostAsync($"/api/v1/work-items/{item.Id}/priority", new { priority = parsed });
        }
    }

    private static readonly System.Text.Json.JsonSerializerOptions JsonOptions = new(System.Text.Json.JsonSerializerDefaults.Web)
    {
        Converters = { new System.Text.Json.Serialization.JsonStringEnumConverter() },
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadInitialDataAsync();
        if (Error is not null)
        {
            // Retry once to ride out a transient server restart.
            Error = null;
            await Task.Delay(1000);
            await LoadInitialDataAsync();
        }
    }

    private async Task LoadInitialDataAsync()
    {
        await LoadPackagesAsync();
        await ApplyQuery();
    }

    private async Task LoadPackagesAsync()
    {
        try
        {
            Packages = await Http.GetFromJsonAsync<List<PackageDto>>("/api/v1/packages", JsonOptions) ?? new List<PackageDto>();
        }
        catch
        {
            Packages = Array.Empty<PackageDto>();
        }
    }

    private async Task ApplyQuery()
    {
        IsBusy = true;
        Error = null;
        try
        {
            var query = new List<string>();
            if (!string.IsNullOrEmpty(Confidential)) query.Add($"confidential={Confidential}");
            if (!string.IsNullOrEmpty(ExecutiveReview)) query.Add($"executiveReview={ExecutiveReview}");
            if (!string.IsNullOrEmpty(Status)) query.Add($"status={Status}");
            if (!string.IsNullOrEmpty(Type)) query.Add($"type={Type}");
            if (!string.IsNullOrEmpty(PackageId)) query.Add($"packageId={PackageId}");
            query.Add($"sortBy={SortBy}");
            query.Add($"sortDescending={SortDescending}");
            query.Add($"groupBy={GroupBy}");

            string url = "/api/v1/work-items?" + string.Join("&", query);
            Result = await Http.GetFromJsonAsync<WorkItemQueryResultDto>(url, JsonOptions);
        }
        catch (Exception ex)
        {
            Error = ApiErrorFormatter.Format(ex);
        }
        finally
        {
            IsBusy = false;
        }
    }

    private sealed record WorkItemQueryResultDto(IReadOnlyList<WorkItemGroupDto> Groups, int TotalCount);

    private sealed record WorkItemGroupDto(string Key, int Count, IReadOnlyList<WorkTaskDto> Items);

    private sealed record WorkTaskDto(
        Guid Id,
        string Identifier,
        WorkItemType Type,
        string Title,
        string? Description,
        DateOnly? DueDate,
        TaskPriority Priority,
        WorkTaskStatus Status,
        string? Owner,
        string StoryId,
        string RequirementId,
        DateTimeOffset CreatedAt,
        DateTimeOffset UpdatedAt,
        bool IsConfidential,
        bool IsExecutiveReview,
        WorkflowStatus WorkflowStatus,
        IReadOnlyList<string> RequiredReviewerKeys,
        IReadOnlyList<WorkflowReviewDto> Reviews,
        ExecutiveReviewStatus ExecutiveReviewStatus,
        IReadOnlyList<ExecutiveReviewerDto> ExecutiveReviewers,
        IReadOnlyList<ExecutiveReviewAdjustmentDto> AdjustmentNotes,
        IReadOnlyList<WorkflowStepDto> Steps);

    private sealed record WorkflowReviewDto(Guid Id, string ReviewerKey, WorkflowDecision Decision, string? Comment, DateTimeOffset ReviewedAt);

    private sealed record ExecutiveReviewerDto(Guid Id, string ReviewerKey, int Order, ExecutiveReviewerStatus Status, string? Comment, DateTimeOffset? CompletedAt);

    private sealed record ExecutiveReviewAdjustmentDto(Guid Id, string ReviewerKey, string Note, DateTimeOffset AdjustedAt);

    private sealed record WorkflowStepDto(Guid Id, string Name, DateOnly? DueDate, WorkflowStepStatus Status);

    private sealed record PackageDto(Guid Id, string Name);
}
