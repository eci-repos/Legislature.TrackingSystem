    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Legislature.TrackingSystem.Web.Client\Legislature.TrackingSystem.Web.Client.csproj" />
